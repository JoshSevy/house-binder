{
  // Start from markdownlint defaults; relax rules that get in the way of house docs.
  "default": true,

  // Long product names, schedules, and notes are normal here.
  "MD013": false,

  // MkDocs Material admonitions and other HTML are fine.
  "MD033": false,

  // Pages may start with metadata or intro text before the title.
  "MD041": false,

  // These docs intentionally use multiple top-level sections per page.
  "MD025": false,

  // Repeated section names under different top-level sections are OK.
  "MD024": {
    "siblings_only": true
  },

  // Table alignment is too noisy for these docs; rely on visual review instead.
  "MD060": false
}
